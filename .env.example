# Ledger environment variables (copy to .env — never commit .env)
# All vars use the LEDGER_ prefix.

# Logging
LEDGER_LOG_LEVEL=INFO
LEDGER_LOG_JSON=false

# Database (passwords MUST come from env, never from YAML)
LEDGER_DB_TYPE=mysql
LEDGER_DB_HOST=localhost
LEDGER_DB_PORT=3306
LEDGER_DB_NAME=myapp
LEDGER_DB_USER=root
LEDGER_DB_PASSWORD=

# Storage
LEDGER_STORAGE_TYPE=local
LEDGER_STORAGE_PATH=./backups
# LEDGER_STORAGE_BUCKET=my-backups
# LEDGER_STORAGE_REGION=us-east-1

# Encryption (32-byte key, base64-encoded recommended)
# LEDGER_ENCRYPT_BACKUPS=true
# LEDGER_ENCRYPTION_KEY=

# Notifications
# LEDGER_SLACK_WEBHOOK_URL=

# Cloud credentials use standard provider env vars:
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
# GOOGLE_APPLICATION_CREDENTIALS
# AZURE_STORAGE_CONNECTION_STRING
